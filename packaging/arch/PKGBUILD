# Maintainer: wh01s17
pkgname=evo8-linux-git
_name=evo8-linux
pkgver=r0
pkgrel=1
pkgdesc="Control del Audient EVO 8 en Linux: mezcla de monitoreo interna, loop-back, preamps, mezclador para PipeWire y micrófono virtual opcional"
arch=('any')
url="https://github.com/wh01s17/evo8-linux"
license=('MIT')
depends=(
  'python'
  'pipewire'
  'pipewire-pulse'
  'wireplumber'
  'libpulse'        # pactl
  'alsa-utils'      # amixer
  'python-pyusb'    # hardware control over USB
  'pyside6'         # mixer window
  'qt6-declarative' # QtQuick modules the window loads
  'qt6-svg'         # the SVG icon
  'ttf-jetbrains-mono-nerd'
)
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
provides=("$_name")
conflicts=("$_name")
install=evo8-linux.install
source=("$_name::git+https://github.com/wh01s17/evo8-linux.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_name"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd "$_name"
  python -m build --wheel --no-isolation
}

check() {
  cd "$_name"
  QT_QPA_PLATFORM=offscreen PYTHONPATH=src python -m unittest discover -s tests
}

package() {
  cd "$_name"
  python -m installer --destdir="$pkgdir" dist/*.whl

  # PipeWire looks for configs in /usr/share; a file with the same name in
  # ~/.config/pipewire overrides it. The Mezcla is a config of its own, run by
  # evo8-mezcla.service (`pipewire -c evo8-mezcla.conf`) only while it is on.
  install -Dm644 src/evo8/data/pipewire/evo8-mezcla.conf "$pkgdir/usr/share/pipewire/evo8-mezcla.conf"
  install -Dm644 src/evo8/data/pipewire/pipewire-pulse.conf.d/20-bloquear-volumen-micro.conf \
    "$pkgdir/usr/share/pipewire/pipewire-pulse.conf.d/20-bloquear-volumen-micro.conf"

  install -Dm644 src/evo8/data/udev/70-audient-evo8.rules "$pkgdir/usr/lib/udev/rules.d/70-audient-evo8.rules"
  install -Dm644 src/evo8/data/systemd/evo8-restore.service "$pkgdir/usr/lib/systemd/user/evo8-restore.service"
  install -Dm644 src/evo8/data/systemd/evo8-mezcla.service "$pkgdir/usr/lib/systemd/user/evo8-mezcla.service"
  sed -i 's|%h/.local/bin/evoctl|/usr/bin/evoctl|' "$pkgdir/usr/lib/systemd/user/evo8-restore.service" \
    "$pkgdir/usr/lib/systemd/user/evo8-mezcla.service"
  install -Dm644 src/evo8/data/applications/evo8-mixer.desktop "$pkgdir/usr/share/applications/evo8-mixer.desktop"
  install -Dm644 src/evo8/data/evo8-mixer.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/evo8-mixer.svg"

  install -Dm644 README.md "$pkgdir/usr/share/doc/$_name/README.md"
  install -Dm644 docs/protocolo-usb.md "$pkgdir/usr/share/doc/$_name/protocolo-usb.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
